COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# LLM narrative provider: Anthropic is used whenever ANTHROPIC_API_KEY is set
# (the local dev default). Otherwise, if GEMINI_API_KEY is set, Gemini is
# used instead -- Gemini has a free tier, so Render deployments should set
# GEMINI_API_KEY and leave ANTHROPIC_API_KEY unset. To test the Gemini path
# locally, comment out ANTHROPIC_API_KEY below while keeping GEMINI_API_KEY.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

NOMINATIM_CONTACT_EMAIL=
